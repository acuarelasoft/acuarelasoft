---
interface Item {
  /** id of the section or of the heading that labels it */
  id: string;
  label: string;
}

interface Props {
  items: Item[];
  label?: string;
}

const { items, label = 'Secciones de la página' } = Astro.props;
---

<nav class="section-nav" aria-label={label} data-section-nav>
  <ol>
    {
      items.map(({ id, label }) => (
        <li>
          <a href={`#${id}`} data-target={id}>
            <span class="section-nav-label">{label}</span>
            <span class="section-nav-dot" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .section-nav {
    display: none;
  }

  @media (min-width: 80rem) {
    .section-nav {
      display: block;
      position: fixed;
      top: 50%;
      right: 1rem;
      z-index: 40;
      transform: translateY(-50%);
    }
  }

  ol {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 0.25rem 0.375rem;
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid var(--color-petroleo);
    outline-offset: 2px;
  }

  .section-nav-label {
    padding: 0.2rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-petroleo) 15%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-paper) 94%, transparent);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-ink) 10%, transparent);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    pointer-events: none;
    transition:
      opacity 180ms ease-out,
      transform 180ms ease-out;
  }

  .section-nav-dot {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border: 2px solid color-mix(in srgb, var(--color-petroleo) 55%, transparent);
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    transition:
      transform 180ms ease-out,
      background-color 180ms ease-out,
      border-color 180ms ease-out;
  }

  .section-nav:hover .section-nav-label,
  .section-nav:focus-within .section-nav-label {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  a:hover .section-nav-dot,
  a:focus-visible .section-nav-dot {
    border-color: var(--color-petroleo);
    transform: scale(1.25);
  }

  a[aria-current='true'] .section-nav-dot {
    border-color: var(--color-petroleo);
    background: var(--color-petroleo);
    transform: scale(1.35);
  }

  a[aria-current='true'] .section-nav-label {
    color: var(--color-petroleo);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-nav-label,
    .section-nav-dot {
      transition: none;
    }
  }
</style>

<script>
  let sectionObserver: IntersectionObserver | undefined;

  document.addEventListener('astro:page-load', () => {
    sectionObserver?.disconnect();
    sectionObserver = undefined;

    const nav = document.querySelector<HTMLElement>('[data-section-nav]');
    if (!nav) return;

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[data-target]'));
    const linkBySection = new Map<Element, HTMLAnchorElement>();

    for (const link of links) {
      const target = document.getElementById(link.dataset.target ?? '');
      if (!target) continue;
      linkBySection.set(target.closest('section') ?? target, link);
    }

    const setActive = (active?: HTMLAnchorElement) => {
      for (const link of links) {
        if (link === active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    // A section becomes active when it crosses the middle of the viewport.
    sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(linkBySection.get(entry.target));
        }
      },
      { rootMargin: '-45% 0px -54% 0px' },
    );

    linkBySection.forEach((_, section) => sectionObserver?.observe(section));
  });
</script>
