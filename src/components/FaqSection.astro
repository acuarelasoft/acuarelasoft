---
import { faqs } from '../data/faqs';

interface Props {
  sectionId?: string;
  title?: string;
  limit?: number;
}

const { sectionId = 'preguntas-frecuentes', title = 'Respuestas para decidir con claridad', limit } = Astro.props;
const displayedFaqs = typeof limit === 'number' ? faqs.slice(0, limit) : faqs;
---

<section id={sectionId} class="bg-acuarela-50/45 px-6 py-20 md:py-24" aria-labelledby={`${sectionId}-heading`}>
  <div class="mx-auto max-w-4xl">
    <h2 id={`${sectionId}-heading`} class="mb-8 font-heading text-3xl font-bold text-ink md:text-4xl">{title}</h2>
    <ul class="space-y-4">
      {displayedFaqs.map((faq) => (
        <li>
          <details class="group rounded-soft border border-acuarela-400/20 bg-paper p-5 open:border-acuarela-400/40 md:p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-semibold text-ink">
              {faq.q}
              <span class="shrink-0 text-2xl leading-none text-petroleo transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 font-sans text-sm leading-relaxed text-ink/70">{faq.a}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
