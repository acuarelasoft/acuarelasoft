---
import { landing } from '../data/landing';
---

<section id="hero" class="relative min-h-[86vh] flex items-center overflow-hidden" aria-label="Soluciones digitales para negocios">
  <div class="absolute inset-0 -z-20 bg-paper" aria-hidden="true"></div>
  <div
    class="absolute inset-0 -z-10"
    aria-hidden="true"
    style="background-image: linear-gradient(to right, color-mix(in srgb, var(--color-petroleo) 8%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in srgb, var(--color-petroleo) 8%, transparent) 1px, transparent 1px), radial-gradient(ellipse 78% 58% at 14% 26%, color-mix(in srgb, var(--color-acuarela-500) 22%, transparent) 0%, transparent 70%), radial-gradient(ellipse 60% 52% at 84% 62%, color-mix(in srgb, var(--color-salmon) 16%, transparent) 0%, transparent 64%), radial-gradient(ellipse 44% 42% at 56% 85%, color-mix(in srgb, var(--color-mint) 14%, transparent) 0%, transparent 58%); background-size: 32px 32px, 32px 32px, auto, auto, auto; background-position: center;"
  >
  </div>

  <div class="absolute top-16 right-8 md:right-16 w-12 h-12 md:w-16 md:h-16 rounded-2xl bg-salmon/90 -z-10" aria-hidden="true"></div>
  <div class="absolute bottom-18 left-[48%] hidden md:block w-18 h-18 rounded-3xl bg-acuarela-400/55 blur-[0.5px] -z-10" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 py-18 md:py-24 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-xl">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 rounded-pill border border-acuarela-300/50 bg-acuarela-50/70 text-acuarela-700 font-sans text-sm font-semibold mb-6"
        >
          <span class="size-2 rounded-full bg-salmon"></span>
          {landing.hero_badge}
        </span>

        <h1 class="font-heading text-ink text-5xl sm:text-6xl md:text-7xl leading-[1.02] mb-6">
          {landing.hero_headline_top}
          <span
            class="block italic bg-clip-text text-transparent"
            style="background-image: linear-gradient(96deg, var(--color-acuarela-600) 0%, var(--color-petroleo-dark) 50%, var(--color-coral-ink) 100%);"
          >
            {landing.hero_headline_gradient}
          </span>
        </h1>

        <p class="font-sans text-ink/78 text-lg md:text-2xl max-w-2xl mb-10 leading-relaxed">
          {landing.hero_subheadline}
        </p>

        <nav class="flex flex-col sm:flex-row gap-4 mb-10" aria-label="Acciones principales">
          <a
            href="#contacto"
            class="bg-petroleo text-paper font-sans font-semibold px-8 py-3.5 rounded-soft transition-all duration-200 hover:bg-petroleo-dark hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petroleo text-base text-center"
          >
            {landing.hero_cta_primary}
          </a>
          <a
            href="#servicios"
            class="bg-paper/80 text-ink font-sans font-semibold px-8 py-3.5 rounded-soft border border-ink/15 transition-all duration-200 hover:bg-paper hover:border-ink/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-acuarela-400 text-base text-center"
          >
            {landing.hero_cta_secondary}
          </a>
        </nav>
        <p class="mb-8 -mt-6 font-sans text-sm text-ink/55">
          Cuéntanos qué necesitas; definimos contigo el alcance y la propuesta.
        </p>

        <ul class="flex flex-wrap gap-x-7 gap-y-3 font-sans text-sm text-ink/60" aria-label="Indicadores de confianza">
          {
            [landing.hero_trust_experience, landing.hero_trust_stack, landing.hero_trust_ux].map((trust) => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-petroleo" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                {trust}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative">
        <div class="rounded-[18px] border border-acuarela-300/35 bg-paper/90 backdrop-blur-[3px] p-3 sm:p-4">
          <div class="rounded-[14px] border border-acuarela-300/25 bg-white/75 overflow-hidden">
            <div class="h-10 px-4 flex items-center justify-between border-b border-acuarela-300/20 bg-paper/70">
              <div class="flex items-center gap-2">
                <span class="size-2.5 rounded-full bg-red-300"></span>
                <span class="size-2.5 rounded-full bg-amber-300"></span>
                <span class="size-2.5 rounded-full bg-emerald-400"></span>
              </div>
              <span class="w-26 h-2 rounded-pill bg-ink/8"></span>
            </div>

            <div class="p-4 sm:p-5">
              <div class="flex items-center justify-between border-b border-acuarela-200/70 pb-4">
                <span class="font-heading text-lg font-bold text-petroleo">Tu negocio</span>
                <div class="flex gap-3">
                  <span class="h-2 w-10 rounded-pill bg-ink/15"></span>
                  <span class="h-2 w-10 rounded-pill bg-ink/15"></span>
                  <span class="h-2 w-10 rounded-pill bg-ink/15"></span>
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-4 py-5">
                <div class="flex flex-col justify-center">
                  <span class="h-2 w-16 rounded-pill bg-acuarela-300/70 mb-3"></span>
                  <span class="h-3 w-full rounded-pill bg-ink/15 mb-2"></span>
                  <span class="h-3 w-4/5 rounded-pill bg-ink/15 mb-4"></span>
                  <span class="inline-flex w-fit rounded-pill bg-petroleo px-4 py-2 font-sans text-xs font-semibold text-paper">
                    Contáctanos
                  </span>
                </div>
                <div class="h-32 rounded-soft border border-acuarela-200/70 bg-gradient-to-tr from-acuarela-200/50 via-salmon/20 to-mint/35"></div>
              </div>
              <div class="grid grid-cols-3 gap-3 border-t border-acuarela-200/70 pt-4">
                {[1, 2, 3].map((item) => (
                  <div class="space-y-2">
                    <span class="block h-10 rounded-soft bg-acuarela-100/70"></span>
                    <span class="block h-2 rounded-pill bg-ink/12"></span>
                    <span class="block h-2 w-3/4 rounded-pill bg-ink/10"></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<svg viewBox="0 0 1200 30" preserveAspectRatio="none" class="w-full h-6" aria-hidden="true">
  <path
    d="M0,15 Q100,5 200,14 T400,12 T600,16 T800,11 T1000,15 T1200,13"
    stroke="var(--color-acuarela-500)"
    stroke-opacity="0.3"
    stroke-width="3"
    fill="none"
    stroke-linecap="round"></path>
</svg>
