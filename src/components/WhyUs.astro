---
import { landing } from '../data/landing';

const icons = [
  'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.562.562 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z',
  'M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42',
  'M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L12 12.75 6.429 9.75m11.142 0l4.179 2.25-9.75 5.25-9.75-5.25 4.179-2.25',
  'M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155',
];
const bgs = ['bg-acuarela-400/10', 'bg-salmon/10', 'bg-mint/20', 'bg-acuarela-400/10'];
---

<section id="por-que-nosotros" class="py-20 px-6 reveal" aria-labelledby="why-heading">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 id="why-heading" class="font-heading text-ink text-3xl md:text-4xl font-bold mb-4">
        {landing.why_title}
      </h2>
      <p class="font-sans text-ink/60 text-lg max-w-xl mx-auto">{landing.why_subtitle}</p>
    </div>

    <ul class="grid md:grid-cols-2 gap-8 list-none">
      {
        landing.why_cards.map((card, i) => (
          <li>
            <article class="bg-paper rounded-soft p-8 border border-acuarela-400/15 transition-all duration-250 hover:border-acuarela-400/30 hover:-translate-y-0.5 h-full">
              <div class={`w-12 h-12 mb-5 flex items-center justify-center rounded-soft ${bgs[i % bgs.length]}`}>
                <svg class="w-6 h-6 text-petroleo" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icons[i % icons.length]} />
                </svg>
              </div>
              <h3 class="font-heading text-ink text-xl font-semibold mb-3">{card.title}</h3>
              <p class="font-sans text-ink/70 text-base leading-relaxed">{card.desc}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
