---
import { landing, site } from '../data/landing';
import { contactConfig } from '../data/contact';
import { serviceOptions } from '../data/services';
import { pricing } from '../data/pricing';

interface Props {
  webDesign?: boolean;
  onlineStore?: boolean;
  commercialPhotography?: boolean;
  sectionId?: string;
}

const { webDesign = false, onlineStore = false, commercialPhotography = false, sectionId = 'contacto' } = Astro.props;
const inputClass =
  'w-full px-3 sm:px-4 py-3 rounded-soft bg-white border border-acuarela-400/20 font-sans text-ink text-base transition-all duration-200 focus:outline-none focus:border-acuarela-400/50 focus:ring-2 focus:ring-acuarela-400/15 placeholder:text-ink/30';

const variants = {
  webDesign: {
    projectType: 'websites',
    badge: 'Diseño y desarrollo de sitios web',
    title: 'Solicita una cotización para tu sitio',
    description: 'Comparte qué necesitas presentar y revisaremos contigo el alcance, los materiales y el calendario.',
    benefits: [
      'Sitios corporativos, landing pages y catálogos informativos.',
      'El catálogo no incluye carrito, pagos ni gestión de pedidos; para vender en línea, conoce nuestras tiendas.',
      'La propuesta especifica entregables, precio y plazos.',
    ],
    note: 'El trabajo comienza con anticipo, materiales y accesos completos.',
    contactTitle: 'Cuéntanos sobre tu proyecto',
    contactSubtitle: 'Comparte una forma de contacto y el tipo de sitio que necesitas.',
  },
  onlineStore: {
    projectType: 'online-stores',
    badge: 'Tiendas en línea',
    title: 'Solicita una cotización para tu tienda',
    description: 'Cuéntanos qué vendes, cuántos productos tienes y si ya usas Shopify. Te ayudamos a elegir la opción adecuada antes de iniciar.',
    benefits: [
      'Personalización de tu tienda Shopify o tienda WooCommerce con hosting el primer año.',
      'Alcance cerrado: productos, secciones, pagos y envíos definidos por escrito.',
      'Variantes complejas, integraciones y migraciones se cotizan antes de comprometer la entrega.',
    ],
    note: 'El trabajo comienza con anticipo, catálogo y accesos completos.',
    contactTitle: 'Cuéntanos sobre tu tienda',
    contactSubtitle: 'Comparte una forma de contacto y la solución que te interesa.',
    messageHint: 'Ejemplo: Vendo ropa, tengo 30 productos y ya uso Shopify. Máximo 500 caracteres.',
  },
  commercialPhotography: {
    projectType: 'commercial-photography',
    badge: 'Fotografía comercial',
    title: 'Solicita una cotización para tu sesión',
    description: 'Cuéntanos qué quieres fotografiar y dónde se realizará la sesión; definiremos contigo el alcance antes de agendar.',
    benefits: [
      'Productos, lugares, servicios y equipos de trabajo.',
      'Puedes contratar la sesión por separado o junto con un proyecto web.',
      'La propuesta especifica las tomas, el precio y las condiciones de entrega.',
    ],
    note: 'Confirmamos ubicación, traslado y disponibilidad antes de agendar.',
    contactTitle: 'Cuéntanos sobre tu sesión',
    contactSubtitle: 'Comparte una forma de contacto y lo que te gustaría fotografiar.',
    messageHint: 'Ejemplo: Quiero fotografiar mi equipo y sus actividades en CDMX para mi sitio web. Máximo 500 caracteres.',
  },
};
const variant = onlineStore
  ? variants.onlineStore
  : webDesign
    ? variants.webDesign
    : commercialPhotography
      ? variants.commercialPhotography
      : null;
const projectType = variant?.projectType;
const offerBadge = variant?.badge ?? landing.offer_badge;
const offerTitle = variant?.title ?? landing.offer_title;
const offerDescription = variant?.description ?? landing.offer_desc;
const offerBenefits = variant?.benefits ?? landing.offer_benefits;
const offerNote = variant?.note ?? landing.offer_note;
const contactTitle = variant?.contactTitle ?? landing.contact_title;
const contactSubtitle = variant?.contactSubtitle ?? landing.contact_subtitle;
const messageHint = (variant && 'messageHint' in variant ? variant.messageHint : null) ?? landing.contact_message_hint;
const storePackages = [
  { value: pricing.onlineStores.shopify.id, label: pricing.onlineStores.shopify.name },
  { value: pricing.onlineStores.shopify.fromScratch.id, label: pricing.onlineStores.shopify.fromScratch.name },
  { value: pricing.onlineStores.woocommerce.id, label: pricing.onlineStores.woocommerce.name },
];

// La configuración se expone al script del formulario mediante atributos data-*.
const endpointUrl = contactConfig.endpointUrl;
const turnstileSiteKey = contactConfig.turnstileSiteKey;
const statusMessages = {
  sending: landing.contact_status_sending,
  success: landing.contact_status_success,
  validation: landing.contact_status_validation,
  captcha: landing.contact_status_captcha,
  error: landing.contact_status_error,
  network: landing.contact_status_network,
  missingConfig: landing.contact_status_missing_config,
};
---

<section id={sectionId} class="relative py-20 px-6 overflow-hidden reveal" aria-labelledby="contact-heading">
  <div
    class="absolute inset-0 -z-10"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 65% 70% at 5% 55%, color-mix(in srgb, var(--color-salmon) 12%, transparent) 0%, transparent 60%), radial-gradient(ellipse 50% 55% at 92% 25%, color-mix(in srgb, var(--color-acuarela-500) 10%, transparent) 0%, transparent 55%), radial-gradient(ellipse 40% 40% at 50% 98%, color-mix(in srgb, var(--color-mint) 10%, transparent) 0%, transparent 50%);"
  >
  </div>

  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <div class="lg:sticky lg:top-24">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 rounded-pill border border-salmon/50 bg-salmon/10 text-coral-ink font-sans text-sm font-semibold mb-6"
        >
          <span class="size-2 rounded-full bg-salmon"></span>
          {offerBadge}
        </span>

        <h2 id="contact-heading" class="font-heading text-ink text-3xl md:text-4xl font-bold mb-5 leading-tight">
          {offerTitle}
        </h2>

        <p class="font-sans text-ink/70 text-lg leading-relaxed mb-8">{offerDescription}</p>

        <ul class="space-y-4 mb-8 list-none">
          {
            offerBenefits.map((benefit) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 shrink-0 size-5 rounded-full bg-mint/30 flex items-center justify-center">
                  <svg class="w-3 h-3 text-petroleo" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                </span>
                <span class="font-sans text-ink/80 text-base">{benefit}</span>
              </li>
            ))
          }
        </ul>

        <p class="font-sans text-sm text-ink/70 flex items-center gap-2">
          <svg
            class="w-4 h-4 text-coral-ink shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          {offerNote}
        </p>
      </div>

      <div>
        <div class="mb-6">
          <h3 class="font-heading text-ink text-xl font-semibold mb-1">{contactTitle}</h3>
          <p class="font-sans text-ink/70 text-base">{contactSubtitle}</p>
        </div>

        {/* Envío vía Cloudflare Pages Function + Resend. Ver CLOUDFLARE_PAGES.md */}
        <form
          id="contact-form"
          class="bg-paper/95 rounded-soft border border-acuarela-400/20 p-3 sm:p-6 md:p-8 space-y-6 shadow-sm"
          aria-describedby="contact-status"
          data-endpoint-url={endpointUrl}
          data-status-sending={statusMessages.sending}
          data-status-success={statusMessages.success}
          data-status-validation={statusMessages.validation}
          data-status-captcha={statusMessages.captcha}
          data-status-error={statusMessages.error}
          data-status-network={statusMessages.network}
          data-status-missing-config={statusMessages.missingConfig}
          data-requires-contact-method="true"
        >
          <p
            id="contact-status"
            class="hidden rounded-soft border px-4 py-3 font-sans text-sm"
            role="status"
            aria-live="polite"
          ></p>

          {/* Honeypot anti-spam: los bots lo llenan, las personas no lo ven. */}
          <div class="hidden" aria-hidden="true">
            <label for="website">No llenar este campo</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          {!onlineStore && <input type="hidden" id="package" name="package" value="" />}
          {projectType && <input type="hidden" name="project_type" value={projectType} />}

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block font-sans text-sm font-medium text-ink mb-1.5">
                {landing.contact_name} <abbr title="requerido" class="text-coral-ink no-underline">*</abbr>
              </label>
              <input type="text" id="name" name="name" required maxlength="255" autocomplete="name" class={inputClass} />
            </div>

            <div>
              <label for="email" class="block font-sans text-sm font-medium text-ink mb-1.5">
                {landing.contact_email}
              </label>
              <input
                type="email"
                id="email"
                name="email"
                maxlength="255"
                autocomplete="email"
                class={inputClass}
                aria-describedby="email-hint"
              />
              <p id="email-hint" class="mt-1 font-sans text-xs text-ink/70">Opcional si compartes WhatsApp</p>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="company" class="block font-sans text-sm font-medium text-ink mb-1.5">
                {landing.contact_company}
              </label>
              <input
                type="text"
                id="company"
                name="company"
                maxlength="255"
                autocomplete="organization"
                class={inputClass}
              />
            </div>

            <div>
              <label for="phone" class="block font-sans text-sm font-medium text-ink mb-1.5">
                {landing.contact_phone}
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                maxlength="50"
                autocomplete="tel"
                class={inputClass}
                aria-describedby="phone-hint"
              />
              <p id="phone-hint" class="mt-1 font-sans text-xs text-ink/70">Opcional si compartes correo</p>
            </div>
          </div>

          {!projectType && (
            <div>
              <label for="project_type" class="block font-sans text-sm font-medium text-ink mb-1.5">
                {landing.contact_topic} <abbr title="requerido" class="text-coral-ink no-underline">*</abbr>
              </label>
              <select id="project_type" name="project_type" required class={inputClass}>
                <option value="">{landing.contact_select_placeholder}</option>
                {serviceOptions.map((service) => <option value={service.value}>{service.label}</option>)}
                <option value="not-sure">No estoy seguro; necesito orientación</option>
              </select>
            </div>
          )}

          {onlineStore && (
            <div>
              <label for="package" class="block font-sans text-sm font-medium text-ink mb-1.5">
                Solución que te interesa
              </label>
              <select id="package" name="package" class={inputClass}>
                <option value="">No estoy seguro; necesito orientación</option>
                {storePackages.map((pkg) => <option value={pkg.value}>{pkg.label}</option>)}
              </select>
            </div>
          )}

          {webDesign && !onlineStore && (
            <div>
              <label for="site_type" class="block font-sans text-sm font-medium text-ink mb-1.5">
                Tipo de sitio que necesitas <abbr title="requerido" class="text-coral-ink no-underline">*</abbr>
              </label>
              <select id="site_type" name="site_type" required class={inputClass}>
                <option value="">{landing.contact_select_placeholder}</option>
                <option value="corporate">Sitio web corporativo</option>
                <option value="local-business">Página para negocio local</option>
                <option value="professional">Sitio para profesional</option>
                <option value="landing-page">Landing page para campaña</option>
                <option value="informational-catalog">Catálogo informativo sin compra en línea</option>
                <option value="not-sure">No estoy seguro todavía</option>
              </select>
            </div>
          )}

          <div>
            <label for="message" class="block font-sans text-sm font-medium text-ink mb-1.5">
              {landing.contact_message} <abbr title="requerido" class="text-coral-ink no-underline">*</abbr>
            </label>
            <textarea
              id="message"
              name="message"
              required
              maxlength="500"
              rows="4"
              class={`${inputClass} resize-y`}
              aria-describedby="message-hint"></textarea>
            <p id="message-hint" class="mt-1 font-sans text-xs text-ink/70">{messageHint}</p>
          </div>

          <div class="pt-2">
            {
              turnstileSiteKey && (
                <div class="flex justify-center pb-2">
                  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" />
                </div>
              )
            }
            <button
              id="contact-submit"
              type="submit"
              class="w-full flex items-center justify-center gap-2 bg-petroleo text-paper font-sans font-medium px-10 py-3.5 rounded-soft transition-all duration-200 hover:bg-petroleo-dark hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petroleo text-base disabled:opacity-60 disabled:hover:scale-100"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
                ></path>
              </svg>
              {landing.contact_submit}
            </button>
            <p class="mt-4 font-sans text-sm text-ink/70 text-center">{landing.contact_note}</p>
            <p class="mt-1 font-sans text-xs text-ink/70 text-center">
              <a class="underline hover:text-petroleo" href="/aviso-privacidad/">{landing.contact_privacy}</a>
            </p>
            <p class="mt-2 font-sans text-sm text-ink/70 text-center">
              También: <a class="wrap-anywhere underline hover:text-petroleo" href={`mailto:${site.email}`}>{site.email}</a>
              {' · '}
              <a class="underline hover:text-petroleo" href={site.whatsappCdmx} rel="noopener noreferrer" target="_blank">
                WhatsApp {site.phoneCdmx}
              </a>
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer />}

<script>
  declare global {
    interface Window {
      turnstile?: {
        ready: (callback: () => void) => void;
        render: (container: HTMLElement, options: { sitekey: string; action: string }) => string;
        reset: (widgetId: string) => void;
      };
    }
  }

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form');
    const statusEl = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit');
    const endpointUrl = form?.dataset.endpointUrl ?? '';
    const requiresContactMethod = form?.dataset.requiresContactMethod === 'true';
    const turnstileContainer = form?.querySelector<HTMLElement>('.cf-turnstile') ?? null;
    let turnstileWidgetId: string | null = null;
    const statusMessages = {
      sending: form?.dataset.statusSending ?? '',
      success: form?.dataset.statusSuccess ?? '',
      validation: form?.dataset.statusValidation ?? '',
      captcha: form?.dataset.statusCaptcha ?? '',
      error: form?.dataset.statusError ?? '',
      network: form?.dataset.statusNetwork ?? '',
      missingConfig: form?.dataset.statusMissingConfig ?? '',
    };

    const STATUS_STYLES = {
      info: 'border-acuarela-400/40 bg-acuarela-400/10 text-ink/80',
      success: 'border-mint/50 bg-mint/20 text-petroleo',
      error: 'border-salmon/50 bg-salmon/10 text-ink/80',
    };

    function showStatus(kind: keyof typeof STATUS_STYLES, text: string) {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.classList.remove('hidden', ...Object.values(STATUS_STYLES).flatMap((c) => c.split(' ')));
      statusEl.classList.add(...STATUS_STYLES[kind].split(' '));
    }

    function renderTurnstile() {
      const turnstile = window.turnstile;
      const sitekey = turnstileContainer?.dataset.sitekey;
      const action = turnstileContainer?.dataset.action;
      if (!turnstile || !turnstileContainer || !sitekey || !action || turnstileWidgetId) return;

      turnstile.ready(() => {
        if (!turnstileContainer.isConnected || turnstileWidgetId) return;
        turnstileWidgetId = turnstile.render(turnstileContainer, { sitekey, action });
      });
    }

    renderTurnstile();
    if (!window.turnstile) {
      document
        .querySelector<HTMLScriptElement>('script[src^="https://challenges.cloudflare.com/turnstile/v0/api.js"]')
        ?.addEventListener('load', renderTurnstile, { once: true });
    }

    if (form instanceof HTMLFormElement) {
      const params = new URLSearchParams(window.location.search);
      const service = params.get('service');
      const serviceSelect = form.querySelector('#project_type');
      if (service && serviceSelect instanceof HTMLSelectElement) {
        serviceSelect.value = service;
      }

      const packageInput = form.querySelector('#package');
      const packageId = params.get('package');
      if (packageId && (packageInput instanceof HTMLInputElement || packageInput instanceof HTMLSelectElement)) {
        packageInput.value = packageId;
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (requiresContactMethod) {
          const email = form.querySelector('#email');
          const phone = form.querySelector('#phone');
          if (
            email instanceof HTMLInputElement &&
            phone instanceof HTMLInputElement &&
            !email.value.trim() &&
            !phone.value.trim()
          ) {
            showStatus('error', 'Escribe un correo electrónico o un número de WhatsApp para poder contactarte.');
            email.focus();
            return;
          }
        }
        if (!endpointUrl) {
          showStatus('error', statusMessages.missingConfig);
          return;
        }
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        showStatus('info', statusMessages.sending);
        try {
          const payload = Object.fromEntries(new FormData(form).entries());
          const response = await fetch(endpointUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const json = await response.json().catch(() => ({}));
          if (response.ok && json.ok) {
            showStatus('success', statusMessages.success);
            form.reset();
          } else if (json.error === 'captcha_failed') {
            showStatus('error', statusMessages.captcha);
          } else if (json.error === 'validation_failed') {
            showStatus('error', statusMessages.validation);
          } else {
            showStatus('error', statusMessages.error);
          }
        } catch {
          showStatus('error', statusMessages.network);
        } finally {
          if (turnstileWidgetId) window.turnstile?.reset(turnstileWidgetId);
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    }
  });
</script>
