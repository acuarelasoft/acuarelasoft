---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/landing';

interface Props {
  title?: string;
  metaDescription?: string;
  canonical?: string;
  structuredData?: unknown | unknown[];
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = 'Diseño de páginas web para negocios en México — AcuarelaSoft',
  metaDescription = 'Creamos sitios web para que tu negocio tenga una presencia online clara, profesional y fácil de encontrar.',
  canonical = site.url + Astro.url.pathname,
  structuredData,
  noindex = false,
  ogImage = `${site.url}/logos/acuarelasoft-600.png`,
  ogImageAlt = ogImage === `${site.url}/logos/acuarelasoft-600.png` ? 'AcuarelaSoft' : title,
} = Astro.props;

const ldBlocks = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang={site.languageTag}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-mx" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AcuarelaSoft" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="geo.region" content="MX-DIF" />
    <meta name="geo.placename" content="Ciudad de México" />

    <link rel="icon" href="/iconos/favicon.ico" sizes="any" />
    <link rel="icon" href="/iconos/icon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/iconos/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/iconos/icon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/iconos/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#081b4b" />

    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=instrument-serif:400,400i|dm-sans:400,500,600,700&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
    {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body class="relative bg-paper paper-bg font-sans text-ink antialiased">
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <defs>
        <filter id="watercolor-edge">
          <feTurbulence type="turbulence" baseFrequency="0.03" numOctaves="3" result="turbulence" seed="2"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="6" xChannelSelector="R" yChannelSelector="G"
          ></feDisplacementMap>
        </filter>
      </defs>
    </svg>

    <div class="pointer-events-none fixed inset-0 z-1 overflow-hidden" aria-hidden="true">
      <div
        class="absolute inset-0 opacity-[0.15] mix-blend-multiply"
        style="background-image: url('/assets/textures/texture.webp'); background-repeat: no-repeat; background-size: cover; background-position: center top;"
      >
      </div>
    </div>

    <div class="relative z-10">
      <Header />

      <main>
        <slot />
      </main>

      <Footer />

      <aside class="fixed bottom-6 right-6 z-50" aria-label="WhatsApp">
        <a
          href={site.whatsappFloat}
          rel="noopener noreferrer"
          target="_blank"
          class="flex items-center justify-center w-14 h-14 bg-[#25D366] text-white rounded-full shadow-lg transition-all duration-200 hover:scale-110 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
          aria-label="Contactar por WhatsApp"
        >
          <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
        </a>
      </aside>
    </div>

    <script>
      let revealObserver: IntersectionObserver | undefined;

      document.addEventListener('astro:page-load', () => {
        revealObserver?.disconnect();
        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
        );

        document.querySelectorAll('.reveal').forEach((el) => revealObserver?.observe(el));
      });
    </script>
  </body>
</html>
