---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { site } from '../../data/landing';

const url = `${site.url}/contacto/`;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Contacto', item: url },
  ],
};
---

<Layout
  title="Contacto y cotizaciones — AcuarelaSoft"
  metaDescription="Cuéntanos qué necesita tu negocio. Solicita una cotización de sitios web, tiendas, fotografía comercial y otros servicios digitales."
  canonical={url}
  structuredData={breadcrumb}
>
  <section class="max-w-4xl mx-auto px-6 pt-28 pb-2 md:pt-36 text-center" aria-labelledby="contacto-heading">
    <h1 id="contacto-heading" class="font-heading text-ink text-4xl sm:text-5xl font-bold leading-tight mb-3">
      Solicita una cotización
    </h1>
    <p class="font-sans text-ink/65 text-lg">
      Cuéntanos qué necesita tu negocio y revisaremos contigo el alcance y la propuesta.
    </p>
    <p class="mt-4 font-sans text-sm text-ink/60">
      Directo: <a class="wrap-anywhere underline hover:text-petroleo" href={`mailto:${site.email}`}>{site.email}</a>
      {' · '}
      <a class="underline hover:text-petroleo" href={site.whatsappCdmx} rel="noopener noreferrer" target="_blank">WhatsApp {site.phoneCdmx}</a>
    </p>
  </section>
  <ContactSection />
</Layout>
