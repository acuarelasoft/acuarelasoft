---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import SectionNav from '../../components/SectionNav.astro';
import { site } from '../../data/landing';
import { formatPrice, pricing } from '../../data/pricing';
import { serviceBreadcrumb } from '../../data/services';

const path = '/servicios/tiendas-en-linea/';
const url = `${site.url}${path}`;
const title = 'Tiendas en línea Shopify y WooCommerce — AcuarelaSoft';
const { shopify, woocommerce, care, careNote, extras } = pricing.onlineStores;
const { fromScratch } = shopify;
const description = `Personalización de tiendas Shopify desde ${formatPrice(shopify.price)} + IVA y tiendas WooCommerce desde ${formatPrice(woocommerce.price)} + IVA con un año de hosting. Alcance cerrado y precios claros.`;
const price = (amount: number) => `${formatPrice(amount)} + IVA`;
const extraPrice = (id: string) => extras.find((extra) => extra.id === id)?.price ?? 0;
const quoteHref = (packageId: string) => `?package=${packageId}#cotizar`;

const platforms = [
  {
    id: 'shopify',
    badge: 'Opción 1',
    name: 'Shopify',
    summary: 'Personalizamos tu tienda Shopify sobre un tema existente para que se vea y se organice como tu marca.',
    price: price(shopify.price),
    points: [
      'Tú administras la tienda y pagas la suscripción directamente a Shopify.',
      'El hosting está incluido en tu suscripción.',
      'La implementación más económica para empezar a vender.',
    ],
    tone: 'mint',
  },
  {
    id: 'woocommerce',
    badge: 'Opción 2',
    name: 'WooCommerce',
    summary: 'Diseñamos y configuramos una tienda propia en WordPress; tu equipo la administra día a día.',
    price: price(woocommerce.price),
    points: [
      'Tienda en tu propio sitio, sin suscripción de plataforma.',
      `Hosting, certificado de seguridad y respaldos incluidos ${woocommerce.includedHostingMonths} meses.`,
      'Más trabajo incluido: instalación, carga de catálogo, pagos y envíos.',
    ],
    tone: 'salmon',
  },
];

const comparison = [
  { concept: 'Precio base', shopify: price(shopify.price), woocommerce: price(woocommerce.price), strong: true },
  { concept: 'Servicio', shopify: 'Personalizar tu tienda sobre un tema existente', woocommerce: 'Instalar, configurar y personalizar una tienda sobre un tema estándar' },
  { concept: 'Catálogo incluido', shopify: 'Tu catálogo ya está cargado; ajuste de hasta 10 fichas simples', woocommerce: 'Carga de hasta 20 productos simples' },
  { concept: 'Hosting', shopify: 'Incluido en la suscripción que pagas a Shopify', woocommerce: `${woocommerce.includedHostingMonths} meses incluidos desde la publicación`, strong: true },
  { concept: 'Después del primer año', shopify: 'Continúas pagando tu suscripción a Shopify', woocommerce: `Hosting administrado desde ${price(care[0].price)} al mes` },
  { concept: 'Fotografía', shopify: 'Opcional', woocommerce: 'Opcional' },
  { concept: 'Mantenimiento y cambios posteriores', shopify: 'Opcionales', woocommerce: 'Opcionales, pero recomendables' },
  { concept: 'Pago del proyecto', shopify: `${shopify.payments.length} pagos de ${formatPrice(shopify.payments[0].amount)}`, woocommerce: `${woocommerce.payments.length} pagos: ${woocommerce.payments.map((p) => formatPrice(p.amount)).join(', ')}` },
];

const processSteps = [
  {
    title: 'Conversación inicial',
    description: 'Revisamos qué vendes, cuántos productos tienes, cómo entregas y si ya tienes cuenta en Shopify. Con eso recomendamos la opción adecuada.',
    client: 'Compartes tu catálogo, operación y plataforma actual, si existe.',
    delivery: 'Una recomendación de plataforma y alcance.',
  },
  {
    title: 'Propuesta y cotización',
    description: 'Dejamos por escrito productos, secciones, pagos, envíos, extras, precio, pagos parciales y tiempos estimados.',
    client: 'Autorizas la propuesta y realizas el pago inicial.',
    delivery: 'Una cotización de alcance cerrado.',
  },
  {
    title: 'Diseño y configuración',
    description: 'Personalizamos la tienda con tu identidad, organizamos el catálogo y configuramos lo contemplado en la propuesta.',
    client: 'Entregas logotipo, textos, imágenes, datos de productos y accesos.',
    delivery: 'Una versión de la tienda para revisión.',
  },
  {
    title: 'Pruebas y ajustes',
    description: 'Probamos el recorrido de compra en celular y computadora, y aplicamos hasta dos rondas de ajustes.',
    client: 'Revisas productos, precios, textos y una compra de prueba.',
    delivery: 'La tienda aprobada y lista para publicarse.',
  },
  {
    title: 'Publicación y capacitación',
    description: 'Publicamos la tienda y te mostramos cómo administrar productos, pedidos y contenidos.',
    client: 'Confirmas que los datos publicados sean correctos.',
    delivery: 'Tu tienda en línea y una sesión de capacitación.',
  },
];

const faqs = [
  {
    question: '¿Cuál me conviene: Shopify o WooCommerce?',
    answer: 'Shopify conviene si ya tienes una cuenta y catálogo, o prefieres que la plataforma se encargue del alojamiento a cambio de una suscripción mensual. WooCommerce conviene si quieres una tienda propia en WordPress, con más trabajo de implementación incluido y el primer año de hosting. En la conversación inicial te ayudamos a decidir.',
  },
  {
    question: '¿Qué costos de Shopify no están incluidos?',
    answer: 'La suscripción a Shopify, el dominio, temas de pago, aplicaciones y comisiones por venta los pagas directamente a Shopify o a cada proveedor. Consulta los precios vigentes en el sitio oficial de Shopify.',
  },
  {
    question: '¿Qué pasa si todavía no tengo tienda en Shopify?',
    answer: `Ofrecemos la configuración desde cero por ${price(fromScratch.price)}: incluye la personalización, carga de diez productos simples, una pasarela de pago y hasta dos reglas sencillas de envío. No incluye migraciones ni programación especial.`,
  },
  {
    question: '¿El hosting incluido en WooCommerce cubre el mantenimiento?',
    answer: `No. El hosting cubre el alojamiento, certificado de seguridad y respaldos durante ${woocommerce.includedHostingMonths} meses. Las actualizaciones y comprobaciones de plugins requieren un responsable desde la publicación; puedes contratar el cuidado técnico por ${price(care[1].price)} al mes, hacerlo con tu equipo o con otro proveedor.`,
  },
  {
    question: '¿Qué ocurre después del primer año en WooCommerce?',
    answer: `Puedes continuar con el hosting administrado desde ${price(care[0].price)} al mes, o con hosting y cuidado técnico por ${price(care[2].price)} al mes, que sustituye al anterior.`,
  },
  {
    question: '¿Puedo agregar más productos, variantes o integraciones?',
    answer: `Sí. Cada producto simple adicional cuesta ${price(extraPrice('product'))} con datos e imágenes completos. Variantes complejas, integraciones, facturación automática, ERP o migraciones se cotizan antes de comprometer la entrega.`,
  },
  {
    question: '¿Garantizan ventas?',
    answer: 'No. Entregamos una tienda funcional y bien presentada con el alcance acordado; las ventas dependen de tu oferta, precios, logística y promoción.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Tiendas en línea Shopify y WooCommerce',
  description,
  url,
  serviceType: 'Implementación de tiendas en línea',
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: [
    { '@type': 'Country', name: 'Mexico' },
    { '@type': 'City', name: 'Ciudad de México' },
  ],
  inLanguage: site.languageTag,
  offers: [shopify, fromScratch, woocommerce].map((offer) => ({
    '@type': 'Offer',
    name: offer.name,
    price: offer.price,
    priceCurrency: pricing.currency,
    priceSpecification: { '@type': 'PriceSpecification', price: offer.price, priceCurrency: pricing.currency, valueAddedTaxIncluded: false },
    url: `${url}#opciones`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const breadcrumb = serviceBreadcrumb({ name: 'Tiendas en línea', path });

const sectionNavItems = [
  { id: 'store-heading', label: 'Inicio' },
  { id: 'platforms-heading', label: 'Elige tu plataforma' },
  { id: 'comparison-heading', label: 'Comparativa' },
  { id: 'opciones', label: 'Opciones y precios' },
  { id: 'extras-heading', label: 'Extras' },
  { id: 'formas-de-pago', label: 'Formas de pago' },
  { id: 'after-launch-heading', label: 'Después de publicar' },
  { id: 'process-heading', label: 'Cómo trabajamos' },
  { id: 'materials-heading', label: 'Qué necesitamos' },
  { id: 'faq-heading', label: 'Preguntas frecuentes' },
  { id: 'cotizar', label: 'Cotizar' },
];

const ctaClass =
  'inline-flex items-center justify-center rounded-soft bg-petroleo px-5 py-3 text-center font-sans text-sm font-semibold text-paper transition-colors hover:bg-petroleo-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petroleo';
---

<Layout title={title} metaDescription={description} canonical={url} structuredData={[serviceSchema, faqSchema, breadcrumb]}>
  <section class="relative overflow-hidden bg-paper px-6 pb-20 pt-28 md:pb-28 md:pt-36" aria-labelledby="store-heading">
    <div
      class="absolute inset-0 -z-10"
      aria-hidden="true"
      style="background-image: radial-gradient(ellipse 75% 65% at 8% 20%, color-mix(in srgb, var(--color-acuarela-500) 20%, transparent) 0%, transparent 68%), radial-gradient(ellipse 55% 50% at 88% 70%, color-mix(in srgb, var(--color-salmon) 14%, transparent) 0%, transparent 62%);"
    ></div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <nav class="mb-8 flex flex-wrap items-center gap-2 font-sans text-sm text-ink/50" aria-label="Ruta de navegación">
          <a href="/" class="hover:text-petroleo">Inicio</a>
          <span aria-hidden="true">›</span>
          <a href="/servicios/" class="hover:text-petroleo">Servicios</a>
          <span aria-hidden="true">›</span>
          <span class="text-ink/70" aria-current="page">Tiendas en línea</span>
        </nav>
        <p class="mb-5 inline-flex items-center gap-2 rounded-pill border border-acuarela-300/50 bg-acuarela-50/70 px-4 py-2 font-sans text-sm font-semibold text-acuarela-700">
          <span class="size-2 rounded-full bg-salmon" aria-hidden="true"></span>
          Tiendas en línea · Shopify y WooCommerce
        </p>
        <h1 id="store-heading" class="mb-5 max-w-3xl font-heading text-4xl font-bold leading-[1.08] tracking-tight text-ink sm:text-5xl">
          Diseño de tiendas en línea con Shopify y WooCommerce
        </h1>
        <p class="mb-8 max-w-2xl font-sans text-lg leading-relaxed text-ink/70 md:text-xl">
          Personalizamos tu tienda Shopify o diseñamos y configuramos una tienda WooCommerce que tu equipo administra. Productos, pagos y envíos definidos por escrito antes de empezar.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="#cotizar" class="inline-flex items-center justify-center rounded-soft bg-petroleo px-8 py-3.5 text-center font-sans text-base font-semibold text-paper transition-colors hover:bg-petroleo-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petroleo">
            Solicitar cotización de mi tienda
          </a>
          <a href="#opciones" class="inline-flex items-center justify-center rounded-soft border border-petroleo/30 bg-white/70 px-8 py-3.5 text-center font-sans text-base font-semibold text-petroleo transition-colors hover:bg-acuarela-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petroleo">
            Ver opciones y precios
          </a>
        </div>
        <p class="mt-4 font-sans text-sm text-ink/55">Precios en MXN más IVA para alcances cerrados. Funciones especiales se cotizan antes de comprometer la entrega.</p>
      </div>
      <aside class="overflow-hidden rounded-soft border border-acuarela-400/20 bg-white/80 shadow-sm" aria-labelledby="hero-options-heading">
        <div
          class="px-7 pb-6 pt-8 md:px-8"
          style="background-image: radial-gradient(ellipse 80% 90% at 10% 0%, color-mix(in srgb, var(--color-mint) 28%, transparent) 0%, transparent 70%), radial-gradient(ellipse 70% 80% at 100% 100%, color-mix(in srgb, var(--color-salmon) 22%, transparent) 0%, transparent 70%);"
        >
          <h2 id="hero-options-heading" class="font-heading text-xl font-bold text-ink">Dos caminos para vender en línea</h2>
        </div>
        <ul class="divide-y divide-acuarela-400/15 px-7 md:px-8">
          <li class="py-5">
            <p class="font-sans text-sm font-semibold text-ink">{shopify.name}</p>
            <p class="font-heading text-2xl font-bold text-petroleo">Desde {price(shopify.price)}</p>
            <p class="mt-1 font-sans text-sm leading-relaxed text-ink/65">Sobre tu tienda y catálogo existentes.</p>
          </li>
          <li class="py-5">
            <p class="font-sans text-sm font-semibold text-ink">{woocommerce.name}</p>
            <p class="font-heading text-2xl font-bold text-petroleo">Desde {price(woocommerce.price)}</p>
            <p class="mt-1 font-sans text-sm leading-relaxed text-ink/65">Con {woocommerce.includedHostingMonths} meses de hosting incluidos.</p>
          </li>
        </ul>
        <p class="border-t border-acuarela-400/15 px-7 py-5 font-sans text-sm leading-relaxed text-ink/60 md:px-8">
          ¿Solo quieres mostrar productos sin carrito ni pagos? Un <a href="/diseno-paginas-web-mexico/" class="text-petroleo underline underline-offset-4">sitio web con catálogo informativo</a> puede ser suficiente.
        </p>
      </aside>
    </div>
  </section>

  <section class="px-6 py-20 md:py-24" aria-labelledby="platforms-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 max-w-3xl">
        <h2 id="platforms-heading" class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">Elige la plataforma que se adapta a tu negocio</h2>
        <p class="font-sans text-lg leading-relaxed text-ink/65">
          Las dos opciones permiten mostrar productos, recibir pedidos y aceptar pagos. Cambian quién aloja la tienda, cuánto trabajo incluye la implementación y los costos recurrentes.
        </p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        {platforms.map((platform) => (
          <article class:list={['flex flex-col rounded-soft border bg-white/80 p-7 md:p-8', platform.tone === 'mint' ? 'border-mint/40' : 'border-salmon/35']}>
            <p class:list={['mb-4 inline-flex w-fit items-center rounded-pill px-3 py-1 font-sans text-xs font-semibold', platform.tone === 'mint' ? 'bg-mint/15 text-petroleo' : 'bg-salmon/15 text-coral-ink']}>{platform.badge}</p>
            <h3 class="mb-2 font-heading text-2xl font-semibold text-ink">{platform.name}</h3>
            <p class="mb-4 font-heading text-xl font-bold text-petroleo">Desde {platform.price}</p>
            <p class="mb-6 font-sans text-sm leading-relaxed text-ink/70">{platform.summary}</p>
            <ul class="mt-auto space-y-3 border-t border-acuarela-400/15 pt-5 font-sans text-sm leading-relaxed text-ink/70">
              {platform.points.map((point) => <li class="flex gap-3"><span class="text-petroleo" aria-hidden="true">✓</span><span>{point}</span></li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-acuarela-50/45 px-6 py-20 md:py-24" aria-labelledby="comparison-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <h2 id="comparison-heading" class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">Shopify o WooCommerce: compara opciones y precios</h2>
        <p class="font-sans text-lg leading-relaxed text-ink/65">Lo que incluye cada opción, quién paga el alojamiento y qué ocurre después del primer año.</p>
      </div>
      <div class="grid gap-5 md:hidden">
        {[{ name: shopify.name, key: 'shopify' as const }, { name: woocommerce.name, key: 'woocommerce' as const }].map((option) => (
          <article class="rounded-soft border border-acuarela-400/20 bg-paper p-5">
            <h3 class="mb-3 font-heading text-xl font-semibold text-ink">{option.name}</h3>
            <dl class="divide-y divide-acuarela-400/15 font-sans text-sm">
              {comparison.map((row) => (
                <div class="py-3">
                  <dt class="font-semibold text-ink">{row.concept}</dt>
                  <dd class:list={['mt-1 leading-relaxed', row.strong ? 'font-semibold text-petroleo' : 'text-ink/70']}>{row[option.key]}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
      <div class="hidden overflow-x-auto rounded-soft border border-acuarela-400/20 bg-paper md:block">
        <table class="w-full min-w-[40rem] border-collapse text-left font-sans text-sm">
          <caption class="sr-only">Comparativa entre personalización Shopify y tienda inicial WooCommerce</caption>
          <thead>
            <tr class="border-b border-acuarela-400/20 bg-white/70">
              <th scope="col" class="w-1/4 px-5 py-4 font-semibold text-ink/70">Concepto</th>
              <th scope="col" class="px-5 py-4 font-heading text-lg font-semibold text-ink">{shopify.name}</th>
              <th scope="col" class="px-5 py-4 font-heading text-lg font-semibold text-ink">{woocommerce.name}</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr class="border-b border-acuarela-400/15 last:border-b-0">
                <th scope="row" class="px-5 py-4 align-top font-semibold text-ink">{row.concept}</th>
                <td class:list={['px-5 py-4 align-top leading-relaxed', row.strong ? 'font-semibold text-petroleo' : 'text-ink/70']}>{row.shopify}</td>
                <td class:list={['px-5 py-4 align-top leading-relaxed', row.strong ? 'font-semibold text-petroleo' : 'text-ink/70']}>{row.woocommerce}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="opciones" class="px-6 py-20 md:py-24" aria-labelledby="opciones-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <h2 id="opciones-heading" class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">Qué incluye cada opción</h2>
        <p class="font-sans text-lg leading-relaxed text-ink/65">Precios base para alcances cerrados. Si tu tienda necesita algo distinto, lo cotizamos antes de iniciar.</p>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">
        <article class="flex flex-col rounded-soft border border-mint/40 bg-paper p-6 md:p-8">
          <h3 class="mb-3 font-heading text-2xl font-bold text-ink">{shopify.name}</h3>
          <p class="mb-4 font-sans text-sm leading-relaxed text-ink/70">{shopify.audience}</p>
          <p class="mb-6 font-heading text-2xl font-bold text-petroleo">Desde {price(shopify.price)} {shopify.billing}</p>
          <h4 class="mb-3 font-sans text-sm font-semibold text-ink">Qué incluye</h4>
          <ul class="mb-6 space-y-3 font-sans text-sm leading-relaxed text-ink/70">
            {shopify.includes.map((item) => <li class="flex gap-2"><span class="text-petroleo" aria-hidden="true">✓</span><span>{item}</span></li>)}
          </ul>
          <div class="mb-6 rounded-soft bg-acuarela-50/60 p-5">
            <div class="mb-2 flex flex-wrap items-baseline justify-between gap-x-3">
              <h4 class="font-sans text-base font-semibold text-ink">{fromScratch.name}</h4>
              <p class="font-heading text-lg font-bold text-petroleo">{price(fromScratch.price)}</p>
            </div>
            <p class="mb-3 font-sans text-sm leading-relaxed text-ink/70">{fromScratch.description}</p>
            <ul class="mb-3 space-y-2 font-sans text-sm leading-relaxed text-ink/70">
              {fromScratch.adds.map((item) => <li class="flex gap-2"><span class="text-petroleo" aria-hidden="true">+</span><span>{item}</span></li>)}
            </ul>
            <p class="font-sans text-xs leading-relaxed text-ink/55">{fromScratch.note}</p>
          </div>
          <h4 class="mb-3 font-sans text-sm font-semibold text-ink">Condiciones importantes</h4>
          <ul class="mb-6 space-y-3 font-sans text-sm leading-relaxed text-ink/70">
            {shopify.conditions.map((item) => <li class="flex gap-2"><span class="text-petroleo" aria-hidden="true">•</span><span>{item}</span></li>)}
          </ul>
          <div class="mt-auto flex flex-col gap-3 sm:flex-row">
            <a href={quoteHref(shopify.id)} class={ctaClass}>Consultar personalización</a>
            <a href={quoteHref(fromScratch.id)} class="inline-flex items-center justify-center rounded-soft border border-petroleo/30 px-5 py-3 text-center font-sans text-sm font-semibold text-petroleo transition-colors hover:bg-acuarela-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petroleo">Consultar desde cero</a>
          </div>
        </article>

        <article class="flex flex-col rounded-soft border border-salmon/35 bg-paper p-6 md:p-8">
          <h3 class="mb-3 font-heading text-2xl font-bold text-ink">{woocommerce.name}</h3>
          <p class="mb-4 font-sans text-sm leading-relaxed text-ink/70">{woocommerce.audience}</p>
          <p class="font-heading text-2xl font-bold text-petroleo">Desde {price(woocommerce.price)} {woocommerce.billing}</p>
          <p class="mb-6 mt-2 font-sans text-sm leading-relaxed text-ink/70">
            Incluye {woocommerce.includedHostingMonths} meses de hosting. A partir del mes {woocommerce.includedHostingMonths + 1}, hosting administrado desde {price(care[0].price)} al mes.
          </p>
          <h4 class="mb-3 font-sans text-sm font-semibold text-ink">Qué incluye</h4>
          <ul class="mb-6 space-y-3 font-sans text-sm leading-relaxed text-ink/70">
            {woocommerce.includes.map((item) => <li class="flex gap-2"><span class="text-petroleo" aria-hidden="true">✓</span><span>{item}</span></li>)}
          </ul>
          <h4 class="mb-3 font-sans text-sm font-semibold text-ink">No incluye</h4>
          <ul class="mb-6 grid gap-x-4 gap-y-2 font-sans text-sm leading-relaxed text-ink/70 sm:grid-cols-2">
            {woocommerce.excludes.map((item) => <li class="flex gap-2"><span class="text-petroleo" aria-hidden="true">•</span><span>{item}</span></li>)}
          </ul>
          <a href={quoteHref(woocommerce.id)} class:list={[ctaClass, 'mt-auto']}>Consultar tienda WooCommerce</a>
        </article>
      </div>
      <p class="mt-6 font-sans text-xs leading-relaxed text-ink/55">
        Precios base en MXN más IVA, sujetos al alcance descrito. No garantizamos ventas ni rentabilidad: los resultados dependen de tu oferta, precios, logística y promoción.
      </p>
    </div>
  </section>

  <section class="bg-acuarela-50/45 px-6 py-20 md:py-24" aria-labelledby="extras-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <h2 id="extras-heading" class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">Extras para ambas opciones</h2>
        <p class="font-sans text-lg leading-relaxed text-ink/65">Agrega solo lo que tu tienda necesita. Cada extra se confirma en la propuesta antes de realizarse.</p>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {extras.map((extra) => (
          <li class="flex flex-col rounded-soft border border-acuarela-400/20 bg-paper p-6">
            <h3 class="mb-2 font-sans text-base font-semibold text-ink">{extra.name}</h3>
            <p class="mb-3 font-heading text-xl font-bold text-petroleo">
              {extra.price === null ? 'Cotización' : `${price(extra.price)}${extra.unit ? ` ${extra.unit}` : ''}`}
            </p>
            <p class="font-sans text-sm leading-relaxed text-ink/70">{extra.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="formas-de-pago" class="px-6 py-20 md:py-24" aria-labelledby="payment-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 max-w-3xl">
        <h2 id="payment-heading" class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">Formas de pago</h2>
        <p class="font-sans text-lg leading-relaxed text-ink/65">
          Elige la opción que mejor se adapte a tu negocio. La forma de pago queda establecida en la propuesta antes de iniciar.
        </p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        <article class="flex flex-col rounded-soft border border-mint/40 bg-white/80 p-7 md:p-8">
          <p class="mb-4 inline-flex w-fit items-center rounded-pill bg-mint/15 px-3 py-1 font-sans text-xs font-semibold text-petroleo">Opción 1</p>
          <h3 class="mb-3 font-heading text-2xl font-semibold text-ink">Pagos parciales por avance</h3>
          <p class="mb-6 font-sans text-sm leading-relaxed text-ink/70">Divide el precio base del proyecto en pagos ligados a cada etapa. Los montos son antes de IVA.</p>
          <div class="mt-auto space-y-5">
            {[shopify, woocommerce].map((option) => (
              <div>
                <h4 class="mb-3 font-sans text-sm font-semibold text-ink">{option.name} · {option.payments.length} pagos</h4>
                <ol class:list={['grid gap-3', option.payments.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
                  {option.payments.map((payment) => (
                    <li class="rounded-soft border border-acuarela-400/15 bg-paper p-4">
                      <span class="block font-heading text-xl text-petroleo">{formatPrice(payment.amount)}</span>
                      <span class="mt-1 block font-sans text-sm font-semibold text-ink">{payment.label}</span>
                      <span class="mt-1 block font-sans text-xs leading-relaxed text-ink/60">{payment.when}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </article>
        <article class="flex flex-col rounded-soft border border-salmon/35 bg-white/80 p-7 md:p-8">
          <p class="mb-4 inline-flex w-fit items-center rounded-pill bg-salmon/15 px-3 py-1 font-sans text-xs font-semibold text-coral-ink">Opción 2</p>
          <h3 class="mb-3 font-heading text-2xl font-semibold text-ink">Meses sin intereses con Mercado Pago</h3>
          <p class="mb-6 font-sans text-sm leading-relaxed text-ink/70">
            Paga tu proyecto con tarjeta de crédito a meses sin intereses a través de Mercado Pago.
          </p>
          <ul class="space-y-3 border-t border-salmon/20 pt-5 font-sans text-sm leading-relaxed text-ink/70">
            <li class="flex gap-3"><span class="text-petroleo" aria-hidden="true">✓</span><span>Disponible con tarjetas participantes.</span></li>
            <li class="flex gap-3"><span class="text-petroleo" aria-hidden="true">✓</span><span>Los plazos disponibles dependen de tu banco y de las promociones vigentes en Mercado Pago.</span></li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-acuarela-50/45 px-6 py-20 md:py-24" aria-labelledby="after-launch-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <h2 id="after-launch-heading" class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">Hosting, mantenimiento y qué pasa después</h2>
        <p class="font-sans text-lg leading-relaxed text-ink/65">
          Una tienda necesita alojamiento y alguien responsable de su cuidado técnico. Así funciona en cada opción.
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <article class="rounded-soft border border-acuarela-400/15 bg-paper p-6">
          <h3 class="mb-2 font-heading text-lg font-semibold text-ink">Con Shopify</h3>
          <p class="font-sans text-sm leading-relaxed text-ink/70">
            El hosting está incluido en tu suscripción. Tú continúas pagando Shopify, junto con dominio, temas de pago, aplicaciones y comisiones. El costo total depende del plan y las aplicaciones que elijas; consulta los{' '}
            <a href={shopify.officialPricingUrl} class="text-petroleo underline underline-offset-4" target="_blank" rel="noopener noreferrer">precios oficiales de Shopify<span class="sr-only"> (abre en otra pestaña)</span></a>.
            Mantenimiento y cambios posteriores son opcionales.
          </p>
        </article>
        <article class="rounded-soft border border-acuarela-400/15 bg-paper p-6">
          <h3 class="mb-2 font-heading text-lg font-semibold text-ink">Con WooCommerce</h3>
          <p class="font-sans text-sm leading-relaxed text-ink/70">
            Hosting, certificado de seguridad y respaldos incluidos durante {woocommerce.includedHostingMonths} meses desde la publicación, más 30 días de garantía sobre defectos de la entrega. Mantenimiento y cambios posteriores son opcionales, pero recomendables.
          </p>
        </article>
        <article class="rounded-soft border border-petroleo/25 bg-white/80 p-6 md:col-span-2 md:p-8">
          <div class="mb-6 rounded-soft border-l-4 border-salmon bg-salmon/10 p-5">
            <h3 class="mb-1 font-sans text-sm font-semibold text-ink">El hosting incluido no equivale a mantenimiento</h3>
            <p class="font-sans text-sm leading-relaxed text-ink/70">{woocommerce.maintenanceNotice}</p>
          </div>
          <h3 class="mb-5 font-heading text-2xl font-bold text-ink">Continuidad para tu tienda WooCommerce</h3>
          <ul class="grid gap-5 md:grid-cols-3">
            {care.map((plan) => (
              <li class="flex flex-col rounded-soft border border-acuarela-400/15 bg-paper p-5">
                <p class="mb-2 flex flex-wrap gap-2 font-sans text-xs font-semibold">
                  <span class="rounded-pill bg-acuarela-50 px-2 py-0.5 text-acuarela-700">{plan.when}</span>
                  {plan.optional && <span class="rounded-pill bg-mint/15 px-2 py-0.5 text-petroleo">Opcional</span>}
                </p>
                <h4 class="mb-1 font-sans text-base font-semibold text-ink">{plan.name}</h4>
                <p class="mb-3 font-heading text-xl font-bold text-petroleo">{price(plan.price)} al mes</p>
                <p class="font-sans text-sm leading-relaxed text-ink/70">{plan.description}</p>
              </li>
            ))}
          </ul>
          <p class="mt-5 font-sans text-xs leading-relaxed text-ink/55">{careNote}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="px-6 py-20 md:py-24" aria-labelledby="process-heading">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 max-w-3xl">
        <h2 id="process-heading" class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">Cómo creamos tu tienda en línea</h2>
        <p class="font-sans text-lg leading-relaxed text-ink/65">
          Avanzamos por etapas y dejamos el alcance y las aprobaciones por escrito. El trabajo comienza con el pago inicial, materiales y accesos completos.
        </p>
      </div>
      <ol class="space-y-5">
        {processSteps.map((step, index) => (
          <li class="grid gap-4 rounded-soft border border-acuarela-400/15 bg-white/80 p-6 sm:grid-cols-[3rem_1fr] md:p-7">
            <span class="flex size-10 items-center justify-center rounded-full bg-petroleo font-sans font-bold text-paper" aria-label={`Etapa ${index + 1}`}>{index + 1}</span>
            <div>
              <h3 class="mb-2 font-heading text-xl font-semibold text-ink">{step.title}</h3>
              <p class="mb-3 font-sans text-sm leading-relaxed text-ink/70">{step.description}</p>
              <p class="font-sans text-xs leading-relaxed text-ink/55"><strong class="text-ink/70">Tu parte:</strong> {step.client}</p>
              <p class="mt-1 font-sans text-xs leading-relaxed text-ink/55"><strong class="text-ink/70">Recibes:</strong> {step.delivery}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-acuarela-50/45 px-6 py-20 md:py-24" aria-labelledby="materials-heading">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_0.8fr]">
      <div>
        <h2 id="materials-heading" class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">Qué necesitamos de tu negocio</h2>
        <p class="mb-6 font-sans text-lg leading-relaxed text-ink/65">
          No necesitas tener todo listo para conversar. Para preparar la tienda, te pediremos:
        </p>
        <ul class="space-y-3 font-sans text-sm leading-relaxed text-ink/70">
          <li>Logotipo y elementos de identidad visual.</li>
          <li>Listado de productos con nombre, precio, descripción, categoría e imágenes.</li>
          <li>Textos para las páginas informativas, como envíos, devoluciones y contacto.</li>
          <li>Zonas y costos de envío, y la pasarela de pago que prefieres usar.</li>
          <li>En Shopify: acceso como colaborador a tu tienda y, si aplica, el tema que usarás.</li>
        </ul>
      </div>
      <aside class="rounded-soft border border-acuarela-400/20 bg-paper p-7">
        <h3 class="mb-3 font-heading text-xl font-semibold text-ink">¿No tienes fotografías de producto?</h3>
        <p class="mb-4 font-sans text-sm leading-relaxed text-ink/70">
          Podemos encargarnos. Las fotografías de producto son opcionales en ambas opciones y se contratan aparte.
        </p>
        <ul class="space-y-3 border-t border-acuarela-400/15 pt-4 font-sans text-sm leading-relaxed text-ink/70">
          <li class="flex gap-3">
            <span class="text-petroleo" aria-hidden="true">✓</span>
            <span><strong class="text-ink">Fotografía de producto:</strong> {price(extraPrice('photography'))} por diez productos simples, con dos fotografías por producto.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-petroleo" aria-hidden="true">✓</span>
            <span><strong class="text-ink">Productos adicionales:</strong> {price(extraPrice('product'))} por producto simple, con datos e imágenes completos.</span>
          </li>
        </ul>
        <p class="mt-4 font-sans text-xs leading-relaxed text-ink/55">La carga de productos no incluye redacción ni retoque de imágenes.</p>
      </aside>
    </div>
  </section>

  <section class="px-6 py-20 md:py-24" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-4xl">
      <h2 id="faq-heading" class="mb-8 font-heading text-3xl font-bold text-ink md:text-4xl">Preguntas frecuentes sobre tiendas en línea</h2>
      <ul class="space-y-4">
        {faqs.map((faq) => (
          <li>
            <details class="group rounded-soft border border-acuarela-400/20 bg-paper p-5 open:border-acuarela-400/40 md:p-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-semibold text-ink">
                {faq.question}
                <span class="shrink-0 text-2xl leading-none text-petroleo transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 font-sans text-sm leading-relaxed text-ink/70">{faq.answer}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="px-6 pt-16 text-center" aria-labelledby="quote-cta-heading">
    <div class="mx-auto max-w-3xl">
      <h2 id="quote-cta-heading" class="mb-3 font-heading text-3xl font-bold text-ink md:text-4xl">Solicita una cotización para tu tienda</h2>
      <p class="font-sans text-lg leading-relaxed text-ink/65">Cuéntanos qué vendes y cómo entregas; te ayudamos a elegir la opción y definir el alcance.</p>
    </div>
  </section>
  <ContactSection onlineStore sectionId="cotizar" />
  <SectionNav items={sectionNavItems} />
</Layout>
