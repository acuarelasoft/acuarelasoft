---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/landing';
import { serviceOptions } from '../../data/services';

const url = `${site.url}/mapa-sitio/`;
---
<Layout
  title="Mapa del sitio — AcuarelaSoft"
  metaDescription="Encuentra los servicios de sitios web, tiendas en línea, fotografía, SEO, contenido y mantenimiento, además de información y contacto de AcuarelaSoft."
  canonical={url}
>
  <section class="max-w-4xl mx-auto px-6 pt-28 pb-10 md:pt-36" aria-labelledby="sitemap-heading">
    <nav class="mb-6 flex items-center gap-2 font-sans text-sm text-ink/50" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-petroleo">Inicio</a><span aria-hidden="true">›</span>
      <span class="text-ink/70" aria-current="page">Mapa del sitio</span>
    </nav>
    <h1 id="sitemap-heading" class="font-heading text-ink text-4xl sm:text-5xl font-bold leading-tight mb-4">
      Mapa del sitio
    </h1>
    <p class="font-sans text-ink/65 text-lg">Servicios, información y contacto de AcuarelaSoft.</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-8 font-sans">
    <h2 class="font-heading text-ink text-2xl font-bold mb-4">Servicios</h2>
    <ul class="space-y-2 text-ink/80">
      <li><a class="hover:text-petroleo underline" href="/servicios/">Todos los servicios</a></li>
      {serviceOptions.map((service) => (
        <li><a class="hover:text-petroleo underline" href={service.path}>{service.label}</a></li>
      ))}
    </ul>

    <h2 class="font-heading text-ink text-2xl font-bold mt-10 mb-4">Ayuda</h2>
    <ul class="space-y-2 text-ink/80">
      <li><a class="hover:text-petroleo underline" href="/preguntas-frecuentes/">Preguntas frecuentes</a></li>
    </ul>

    <h2 class="font-heading text-ink text-2xl font-bold mt-10 mb-4">Compañía</h2>
    <ul class="space-y-2 text-ink/80">
      <li><a class="hover:text-petroleo underline" href="/nosotros/">Nosotros</a></li>
      <li><a class="hover:text-petroleo underline" href="/contacto/">Contacto</a></li>
      <li><a class="hover:text-petroleo underline" href="/aviso-privacidad/">Aviso de privacidad</a></li>
    </ul>
  </section>
</Layout>
