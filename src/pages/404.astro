---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/landing';

const url = `${site.url}/404/`;
---
<Layout
  title="Página no encontrada — AcuarelaSoft"
  metaDescription="La página que buscas no existe o ya no está disponible. Conoce nuestros sitios web para negocios o escríbenos."
  canonical={url}
  noindex={true}
>
  <section class="max-w-3xl mx-auto px-6 pt-32 pb-16 md:pt-40 text-center" aria-labelledby="not-found-heading">
    <p class="font-sans text-sm font-bold uppercase tracking-[0.14em] text-petroleo mb-4">Error 404</p>
    <h1 id="not-found-heading" class="font-heading text-ink text-4xl sm:text-5xl font-bold leading-tight mb-4">
      Esta página se mudó o ya no existe
    </h1>
    <p class="font-sans text-ink/65 text-lg mb-8">
      Puede que la dirección haya cambiado. Puedes conocer nuestro servicio de diseño web o volver al inicio:
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-3">
      <a
        href="/diseno-paginas-web-mexico/"
        class="inline-block bg-petroleo text-paper font-sans font-semibold px-8 py-3.5 rounded-soft hover:bg-petroleo-dark transition-all"
      >
        Conocer diseño web
      </a>
      <a
        href="/"
        class="inline-block border border-acuarela-400/25 bg-paper px-8 py-3.5 rounded-soft font-sans font-semibold hover:border-acuarela-400/40 hover:text-petroleo"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
