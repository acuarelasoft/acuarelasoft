{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acuarelasoft",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-26",
  "vars": {
    "CONTACT_ALLOWED_ORIGINS": "https://acuarelasoft.com",
    "CONTACT_TO": "contacto@acuarelasoft.com",
    "RESEND_FROM": "contacto@acuarelasoft.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
